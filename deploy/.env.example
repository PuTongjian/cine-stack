TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
QUARK_COOKIE=
QUARK_ROOT_FOLDER_ID=
QUARK_LIBRARY_FOLDER_NAME=MovieLibrary
QUARK_LIBRARY_FOLDER_ID=
SUENEN_USERNAME=
SUENEN_PASSWORD=
ADMIN_PASSWORD=
# Access address must match the address used in your browser
APP_ORIGIN=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Paths are relative to this compose file
STRM_HOST_DIR=./strm
# Source tree to build; deployed Unraid projects use ./source
BUILD_CONTEXT=..
# Optional registry prefixes when Docker Hub is unavailable
NODE_IMAGE=node:24-bookworm-slim
NGINX_IMAGE=nginx:stable-alpine
# Optional HTTP proxy for TMDB; local services and Chinese upstreams bypass it
OUTBOUND_PROXY=
OUTBOUND_NO_PROXY=localhost,127.0.0.1,api,web,.quark.cn,.quarkcdn.com,.suenen.com
