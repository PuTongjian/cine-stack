{
  "name": "movie-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w @movie/api' 'npm run dev -w @movie/web'",
    "start": "npm run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:node": "vitest run packages/crawler-engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "login:node": "node --env-file=.env packages/crawler-engine/src/cli/login.mjs",
    "integrations:check": "node --env-file=.env scripts/check-integrations.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "std-env": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
