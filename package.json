{
  "name": "movie-library",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w @movie/api' 'npm run dev -w @movie/web'",
    "start": "npm run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:node": "vitest run tests/crawler-engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "login:node": "node --env-file=.env packages/crawler-engine/src/cli/login.mjs",
    "integrations:check": "node --env-file=.env scripts/check-integrations.mjs",
    "format": "biome format --write . && eslint . --fix",
    "format:check": "biome format .",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "std-env": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
